# --- SaveStock Zugangsdaten (Admin-Login fuer "/") ---
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
# Wird gesetzt sobald das Passwort ueber "Optionen" geaendert wird.
# Ist ADMIN_PASSWORD_HASH gesetzt, hat es Vorrang vor ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=

# --- Server ---
PORT=3001
# Signiert das Session-Cookie. Beim Aendern werden alle Logins ungueltig.
SESSION_SECRET=bitte-aendern
# Session-Laufzeit in Minuten
SESSION_TTL_MINUTES=120
